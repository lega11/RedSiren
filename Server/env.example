# Copy this file to .env and fill in real values. Never commit .env itself.

# Local MongoDB, or an Atlas connection string:
# mongodb+srv://user:pass@cluster.mongodb.net/red-siren
MONGO_URI=mongodb://127.0.0.1:27017/red-siren

# Long random string used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

PORT=3000
